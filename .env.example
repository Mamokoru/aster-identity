# Local app database. Use a dedicated runtime role, never the postgres superuser.
PGHOST=127.0.0.1
PGPORT=5432
PGDATABASE=aster_auth
PGUSER=aster_app
PGPASSWORD=
PGSSLMODE=disable

# Migration-only database owner credentials. Do not use these for the web app.
PGMIGRATIONUSER=postgres
PGMIGRATIONPASSWORD=

KEYCLOAK_ISSUER=http://localhost:8080/realms/aster
KEYCLOAK_CLIENT_ID=aster-web
KEYCLOAK_CLIENT_SECRET=
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=